#!/bin/bash

PARAM_1=$1
PARAM_2=$2

# Persistence
LPM_STATE_DIR="${HOME}/.lpm"
LPM_STATE_FILE="${LPM_STATE_DIR}/state"
LPM_HISTORY_FILE="${LPM_STATE_DIR}/history"

# Ensure state directory exists, create if missing
function ensure_state_dir() {
    [[ -d "$LPM_STATE_DIR" ]] || mkdir -p "$LPM_STATE_DIR"
}

# Load persisted state from file, or initialize defaults if file missing
function load_state() {
    ensure_state_dir
    if [[ -f "$LPM_STATE_FILE" ]]; then
        source "$LPM_STATE_FILE"
    else
        LAST_UPDATE="never"
        LAST_CLEAN="never"
        INSTALL_COUNT=0
        UPDATE_COUNT=0
    fi
}

# Persist current state to file
function save_state() {
    ensure_state_dir
    cat > "$LPM_STATE_FILE" << EOF
LAST_UPDATE="${LAST_UPDATE}"
LAST_CLEAN="${LAST_CLEAN}"
INSTALL_COUNT=${INSTALL_COUNT}
UPDATE_COUNT=${UPDATE_COUNT}
EOF
}

# Increment install counter and persist
function record_install() {
    load_state
    INSTALL_COUNT=$((INSTALL_COUNT + 1))
    save_state
}

# Record last update timestamp and increment update counter
function record_update() {
    load_state
    LAST_UPDATE=$(date +"%Y-%m-%d %H:%M:%S")
    UPDATE_COUNT=$((UPDATE_COUNT + 1))
    save_state
}

# Record last clean timestamp
function record_clean() {
    load_state
    LAST_CLEAN=$(date +"%Y-%m-%d %H:%M:%S")
    save_state
}

# Colors
RCol='\033[0m'    # Text Reset
Red='\033[0;31m'  # Red
Gre='\033[0;32m'  # Green
Yel='\033[0;33m'  # Yellow
Blu='\033[0;34m'  # Blue

# Function to detect Linux distribution and package manager
detect_distro() {
    # Default to Debian/Ubuntu (apt)
    DISTRO="debian"
    PACKAGE_MANAGER="apt"

    # Check /etc/os-release for distribution info
    if [[ -f /etc/os-release ]]; then
        . /etc/os-release

        # Check for Fedora/RHEL/CentOS
        if [[ "$ID" == "fedora" ]] || [[ "$ID" == "rhel" ]] || [[ "$ID" == "centos" ]] || [[ "$ID" == "rocky" ]] || [[ "$ID" == "alma" ]]; then
            DISTRO="fedora"
            PACKAGE_MANAGER="dnf"
        # Check for Arch-based distributions
        elif [[ "$ID" == "arch" ]] || [[ "$ID_LIKE" == *"arch"* ]] || [[ "$ID" == "arcolinux" ]]; then
            DISTRO="arch"
            PACKAGE_MANAGER="pacman"
        fi
    fi

    # Fallback check for pacman presence
    if command -v pacman &> /dev/null; then
        if [[ -f /etc/arch-release ]] || [[ "$DISTRO" == "arch" ]]; then
            DISTRO="arch"
            PACKAGE_MANAGER="pacman"
        fi
    fi

    # Fallback check for dnf presence (Fedora/RHEL)
    if command -v dnf &> /dev/null; then
        DISTRO="fedora"
        PACKAGE_MANAGER="dnf"
    fi

    echo "$PACKAGE_MANAGER"
}

